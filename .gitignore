# ══════════════════════════════════════════════════════════════════════
# AuraVox — .gitignore
# Excludes all personal data, user profiles, chat histories, generated
# or uploaded multimedia/files, cloned voices, long-term memories,
# reminders, lists, RAG documents, API credentials, backups, model
# caches, and the local embedded Python runtime.
# ══════════════════════════════════════════════════════════════════════

# ── Personal configuration & user-generated state ────────────────────
# Only clean *.example.* templates and languages.txt are tracked in Git.
config/assistants.yaml
config/voice_settings.yaml
config/spotify_config.yaml
config/wake_words.txt
config/*.bak
config/*.tmp
config/profiles.json
config/reminders.json
config/mcp.json
config/plugins.json
config/network.json
config/voice_listener.json
config/model_memory.json
config/model_updates.json
config/llm_providers.json
config/secrets.json

# ── User data directories & chat-generated content ───────────────────
config/chats/
config/comfyui/
config/custom_voices/
config/memory/
config/lists/
config/routines/
config/knowledge/
config/certs/

# ── Generated audio & personal cloned voice previews ─────────────────
audio/*.wav
audio/*.mp3
audio/*.ogg
audio/*.webm
audio/voice_previews/*/custom-*

# ── Backups, assistant exports (.auravox), and server logs ───────────
backups/
*.auravox
*.auravox-backup.zip
logs/
*.log

# ── Embedded Python runtime & AI model caches (HuggingFace/Whisper/TTS)
python/
cache/
.venv/
venv/

# ── Python bytecode & OS temporary files ─────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.env
.env.*
.DS_Store
Thumbs.db
desktop.ini
